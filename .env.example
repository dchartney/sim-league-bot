# OpenBao AppRole (leave all three unset to skip OpenBao entirely and rely on
# the plaintext values below instead - only sane for local dev, never commit
# real values).
# NOTE: unlike household-manager, this bot does NOT run on VM 107 (where
# OpenBao's container binds to 127.0.0.1:8200) - it runs on its own LXC, so
# it must reach OpenBao over the LAN via Caddy instead.
BAO_ADDR=https://secrets.hartney.me
BAO_ROLE_ID=da39a127-09dc-c07b-7781-9c45efd5b142
BAO_SECRET_ID_FILE=/opt/sim-league-bot/.bao-secret-id

# Fallback / local-dev secrets (OpenBao overwrites these when configured above).
DISCORD_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Channel names (no leading #). All TBD - placeholders until David names them.
ESCALATION_CHANNEL_NAME=ricky-bobby
RULEBOOK_LOG_CHANNEL_NAME=ricky-bobby
FEEDBACK_CHANNEL_NAME=bot-reports
# The one server channel where @mentioning the bot gets a natural-language reply
# (admin team chat; access controlled by Discord channel permissions).
ADMIN_CHAT_CHANNEL_NAME=ricky-bobby
# Role pinged on driver reports. ADMIN_ROLE_ID (right-click role > Copy Role ID) is
# more robust than the name; if unset the name is matched case-insensitively.
ADMIN_ROLE_NAME=League ADMINS
#ADMIN_ROLE_ID=

# Cost control on the expensive path (/ruling, /schedule, and DM questions).
RULING_RATE_LIMIT=6
RULING_RATE_WINDOW_SECONDS=3600

# New-driver profile interviews (needs the Server Members intent enabled in the Discord developer portal)
PROFILE_ON_JOIN=
PROFILE_CHANNEL_NAME=driver-profiles
